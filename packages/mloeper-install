#!/bin/bash

# mloeper-install - Interactive installer for optional software packages
# This script provides a user-friendly interface to install additional software

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored messages
print_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

# Check if gum is available
if ! command -v gum &> /dev/null; then
    print_error "gum is not installed. Please run the main install script first."
    exit 1
fi

# Check if running as root or with sudo
if [ "$EUID" -ne 0 ]; then
    print_warning "This script requires root privileges. Restarting with sudo (you may be prompted for your password)..."
    exec sudo "$0" "$@"
fi

# Welcome message
gum style \
    --foreground 212 --border-foreground 212 --border double \
    --align center --width 50 --margin "1 2" --padding "2 4" \
    'mloeper-install' 'Interactive Software Installer'

# Define available packages
PACKAGES=(
    "omnara"
)

# Display the package selection menu
print_info "Select packages to install (use space to select, enter to confirm):"
echo ""

SELECTED_PACKAGES=$(gum choose --no-limit "${PACKAGES[@]}")

# Check if any packages were selected
if [ -z "$SELECTED_PACKAGES" ]; then
    print_warning "No packages selected. Exiting."
    exit 0
fi

# Install selected packages
echo ""
print_info "Installing selected packages..."
echo ""

# Track installation results
FAILED_INSTALLS=()
SUCCESSFUL_INSTALLS=()

# Process each selected package
while IFS= read -r package; do
    case "$package" in
        omnara)
            print_info "Installing omnara..."
            # Note: This executes a remote script as required by omnara's installation method
            if curl -fsSL https://omnara.com/install/install.sh | bash; then
                SUCCESSFUL_INSTALLS+=("omnara")
                print_info "omnara installed successfully!"
                
                # Add omnara to PATH
                OMNARA_PATH_LINE='export PATH="$HOME/.omnara/bin:$PATH"'
                
                # Get the actual user (not root when using sudo)
                ACTUAL_USER="${SUDO_USER:-$USER}"
                ACTUAL_HOME=$(eval echo ~"$ACTUAL_USER")
                
                # Add to .bashrc if it exists and doesn't already contain the PATH entry
                if [ -f "$ACTUAL_HOME/.bashrc" ]; then
                    if ! grep -q '.omnara/bin' "$ACTUAL_HOME/.bashrc"; then
                        echo "" >> "$ACTUAL_HOME/.bashrc"
                        echo "# Added by mloeper-install for omnara" >> "$ACTUAL_HOME/.bashrc"
                        echo "$OMNARA_PATH_LINE" >> "$ACTUAL_HOME/.bashrc"
                        chown "$ACTUAL_USER:$ACTUAL_USER" "$ACTUAL_HOME/.bashrc"
                        print_info "Added omnara to PATH in .bashrc"
                    fi
                fi
                
                # Add to .zshrc if it exists and doesn't already contain the PATH entry
                if [ -f "$ACTUAL_HOME/.zshrc" ]; then
                    if ! grep -q '.omnara/bin' "$ACTUAL_HOME/.zshrc"; then
                        echo "" >> "$ACTUAL_HOME/.zshrc"
                        echo "# Added by mloeper-install for omnara" >> "$ACTUAL_HOME/.zshrc"
                        echo "$OMNARA_PATH_LINE" >> "$ACTUAL_HOME/.zshrc"
                        chown "$ACTUAL_USER:$ACTUAL_USER" "$ACTUAL_HOME/.zshrc"
                        print_info "Added omnara to PATH in .zshrc"
                    fi
                fi
                
                print_info "Restart your shell or run 'source ~/.bashrc' (or ~/.zshrc) to use omnara"
            else
                print_error "Failed to install omnara"
                FAILED_INSTALLS+=("omnara")
            fi
            ;;
        *)
            print_warning "Unknown package: $package"
            ;;
    esac
    echo ""
done <<< "$SELECTED_PACKAGES"

# Print installation summary
echo ""
gum style \
    --foreground 212 --border-foreground 212 --border double \
    --align center --width 50 --margin "1 2" --padding "1 2" \
    'Installation Summary'

if [ ${#SUCCESSFUL_INSTALLS[@]} -gt 0 ]; then
    print_info "Successfully installed (${#SUCCESSFUL_INSTALLS[@]}):"
    for pkg in "${SUCCESSFUL_INSTALLS[@]}"; do
        echo -e "  ${GREEN}✓${NC} $pkg"
    done
fi

if [ ${#FAILED_INSTALLS[@]} -gt 0 ]; then
    echo ""
    print_error "Failed installations (${#FAILED_INSTALLS[@]}):"
    for pkg in "${FAILED_INSTALLS[@]}"; do
        echo -e "  ${RED}✗${NC} $pkg"
    done
    echo ""
    exit 1
fi

echo ""
print_info "All installations complete!"
